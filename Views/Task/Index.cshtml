@model IEnumerable<TaskManager.Models.TaskModel>

<link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" />


@{
    ViewData["Title"] = "Task List";
}

<div class="task-header">
    <h2>Task List</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Task</a>
    </p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Id</td>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
